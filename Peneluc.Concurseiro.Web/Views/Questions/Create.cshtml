@using Peneluc.Concurseiro.Web.ViewModels
@model CreateQuestionViewModel

<h2>Nova Questão</h2>

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label class="form-label">Enunciado</label>
        <textarea asp-for="Statement" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label class="form-label">Explicação</label>
        <textarea asp-for="Explanation" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label class="form-label">Dificuldade</label>
        <select asp-for="Difficulty" class="form-select">
            <option>Easy</option>
            <option>Medium</option>
            <option>Hard</option>
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">SubjectId (GUID)</label>
        <input asp-for="SubjectId" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">ExamSourceId (GUID)</label>
        <input asp-for="ExamSourceId" class="form-control" />
    </div>

    <hr />
    <h5>Alternativas</h5>

    @for (int i = 0; i < 4; i++)
    {
        <div class="mb-2">
            <input name="AnswerOptions[@i].Description"
                   class="form-control"
                   placeholder="Descrição da alternativa" />

            <div class="form-check mt-1">
                <input type="checkbox"
                       name="AnswerOptions[@i].IsCorrect"
                       class="form-check-input" />
                <label class="form-check-label">Correta</label>
            </div>
        </div>
    }

    <button type="submit" class="btn btn-success">Salvar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>

</form>
