@using Peneluc.Concurseiro.Web.ViewModels
@model QuestionViewModel

<h2>Detalhes da Questão</h2>

<div class="card">
    <div class="card-body">
        <h5>@Model.Statement</h5>

        <p><strong>Matéria:</strong> @Model.SubjectName</p>
        <p><strong>Prova:</strong> @Model.ExamName (@Model.ExamYear)</p>
        <p><strong>Dificuldade:</strong> @Model.Difficulty</p>

        <hr />

        <h6>Alternativas</h6>
        <ul>
            @foreach (var alt in Model.AnswerOptions)
            {
                <li>
                    @alt.Description
                    @if (alt.IsCorrect)
                    {
                        <strong>(Correta)</strong>
                    }
                </li>
            }
        </ul>

        <hr />

        <p><strong>Explicação:</strong></p>
        <p>@Model.Explanation</p>
    </div>
</div>

<p class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Voltar</a>
</p>
