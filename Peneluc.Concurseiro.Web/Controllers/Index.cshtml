@using Microsoft.AspNetCore.Html
@using Peneluc.Concurseiro.Web.ViewModels
@model PagedResultViewModel<QuestionViewModel>

@{
    ViewData["Title"] = "Questões";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Questões</h2>
    <a asp-action="Create" class="btn btn-success">Nova Questão</a>
</div>

<!-- Filter Form -->
<form asp-action="Index" method="get" class="card p-3 mb-4">
    <div class="row g-3">
        <div class="col-md-12">
            <label for="searchTerm" class="form-label">Buscar no Enunciado</label>
            <input type="text" name="searchTerm" id="searchTerm" class="form-control" value="@ViewBag.CurrentSearchTerm" placeholder="Digite um termo para buscar..."/>
        </div>
    </div>
    <div class="row g-3 align-items-end mt-2">
        <div class="col-md-3">
            <label class="form-label">Data Início</label>
            <input type="date" name="startDate" class="form-control" value="@ViewBag.CurrentStartDate" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Data Fim</label>
            <input type="date" name="endDate" class="form-control" value="@ViewBag.CurrentEndDate" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Filtrar por Matéria</label>
            <select name="subjectId" class="form-select" asp-items="ViewBag.Subjects">
                <option value="">Todas as Matérias</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Filtrar por Dificuldade</label>
            <select name="difficulty" class="form-select" asp-items="ViewBag.Difficulties">
                <option value="">Todas as Dificuldades</option>
            </select>
        </div>
    </div>
    <div class="row g-3 mt-2">
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Filtrar</button>
        </div>
        <div class="col-md-2">
            <a asp-action="Index" class="btn btn-outline-secondary w-100">Limpar</a>
        </div>
        <div class="col-md-2">
            <button type="submit" asp-action="ExportCsv" class="btn btn-outline-success w-100">Exportar CSV</button>
        </div>
    </div>
</form>

<!-- Questions Table -->
<table class="table table-hover">
    <thead class="table-light">
        <tr>
            <th>
                <a asp-action="Index" 
                   asp-route-sortOrder="@ViewBag.StatementSortParm"
                   asp-route-subjectId="@ViewBag.CurrentSubjectId"
                   asp-route-difficulty="@ViewBag.CurrentDifficulty"
                   asp-route-searchTerm="@ViewBag.CurrentSearchTerm">
                    Enunciado
                </a>
            </th>
            <th>
                <a asp-action="Index" 
                   asp-route-sortOrder="@ViewBag.DifficultySortParm"
                   asp-route-subjectId="@ViewBag.CurrentSubjectId"
                   asp-route-difficulty="@ViewBag.CurrentDifficulty"
                   asp-route-searchTerm="@ViewBag.CurrentSearchTerm">
                    Dificuldade
                </a>
            </th>
            <th style="width: 150px;"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Data)
        {
            <tr>
                <td>
                    @{
                        var searchTerm = ViewBag.CurrentSearchTerm as string;
                        var statement = item.Statement ?? "";
                        var truncatedStatement = statement.Length > 200 ? statement.Substring(0, 200) + "..." : statement;
                        IHtmlContent displayStatement;

                        if (!string.IsNullOrWhiteSpace(searchTerm) && !string.IsNullOrWhiteSpace(statement))
                        {
                            var highlighted = System.Text.RegularExpressions.Regex.Replace(
                                truncatedStatement,
                                System.Text.RegularExpressions.Regex.Escape(searchTerm),
                                match => $"<mark>{match.Value}</mark>",
                                System.Text.RegularExpressions.RegexOptions.IgnoreCase);
                            displayStatement = new HtmlString(highlighted);
                        }
                        else
                        {
                            displayStatement = new HtmlString(truncatedStatement);
                        }
                    }
                    @displayStatement
                </td>
                <td>@item.Difficulty</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal" data-id="@item.Id">
                        Excluir
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Pagination Controls -->
@{
    var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
    var nextDisabled = !Model.HasNextPage ? "disabled" : "";
}

<div class="d-flex justify-content-between align-items-center">
    <a asp-action="Index"
       asp-route-page="@(Model.Page - 1)"
       asp-route-subjectId="@ViewBag.CurrentSubjectId"
       asp-route-difficulty="@ViewBag.CurrentDifficulty"
       asp-route-searchTerm="@ViewBag.CurrentSearchTerm"
       asp-route-startDate="@ViewBag.CurrentStartDate"
       asp-route-endDate="@ViewBag.CurrentEndDate"
       asp-route-sortOrder="@ViewBag.CurrentSortOrder"
       class="btn btn-outline-primary @prevDisabled">
        Anterior
    </a>
    
    <span>Página @Model.Page de @Model.TotalPages</span>

    <a asp-action="Index"
       asp-route-page="@(Model.Page + 1)"
       asp-route-subjectId="@ViewBag.CurrentSubjectId"
       asp-route-difficulty="@ViewBag.CurrentDifficulty"
       asp-route-searchTerm="@ViewBag.CurrentSearchTerm"
       asp-route-startDate="@ViewBag.CurrentStartDate"
       asp-route-endDate="@ViewBag.CurrentEndDate"
       asp-route-sortOrder="@ViewBag.CurrentSortOrder"
       class="btn btn-outline-primary @nextDisabled">
        Próximo
    </a>
</div>

<!-- Modal de Confirmação de Exclusão -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Confirmar Exclusão</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Tem certeza que deseja excluir esta questão? Esta ação não pode ser desfeita.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form id="deleteForm" method="post" asp-action="Delete">
                    <input type="hidden" name="id" id="deleteId" />
                    <button type="submit" class="btn btn-danger">Excluir</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var deleteModal = document.getElementById('deleteModal');
        deleteModal.addEventListener('show.bs.modal', function (event) {
            // Botão que acionou o modal
            var button = event.relatedTarget;
            // Extrai info dos atributos data-*
            var id = button.getAttribute('data-id');
            
            // Atualiza o input hidden do formulário dentro do modal
            var inputId = deleteModal.querySelector('#deleteId');
            inputId.value = id;
        });
    </script>
}